<% layout('layouts/boilerplate')%>
<div id="cluster-map"></div>
<div class="container">
    <h1>All Runningtrails</h1>

    <% for (let runningtrail of runningtrails){%>
    <div class="card mb-3">
        <div class="row">
            <div class="col-md-4">
                <%if(runningtrail.images.length) {%>
                <img class="img-fluid" alt="" src="<%=runningtrail.images[0].url%>">
                <% }else {%>
                <img class="img-fluid" alt="No image available" src="/images/no-image.svg">
                <% } %>
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h5 class="card-title"><%= runningtrail.title %> </h5>

                    <p class="card-text"><%= runningtrail.description %></p>
                    <p class="card-text">
                        <small class="text-muted"><%= runningtrail.location%></small>
                    </p>
                    <a class="btn btn-primary" href="/runningtrails/<%=runningtrail._id%>">View <%=runningtrail.title%></a>
                </div>
            </div>
        </div>
    </div>
    <% }%>
</div>
<script>
    const mapToken = '<%-process.env.MAPBOX_TOKEN%>';
    const runningtrails = { features: <%- JSON.stringify(runningtrails) %>}
</script>

<script src="/javascripts/clusterMap.js"></script>