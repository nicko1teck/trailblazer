# Copy this file to ".env" for local development and fill in real values.
# ".env" is git-ignored. NEVER commit real credentials.
# In production (NODE_ENV=production) the .env file is NOT loaded -
# supply these as real environment variables (see ecosystem.config.example.js).

# --- Database (MongoDB) ---
# Optional locally (defaults to mongodb://localhost:27017/trail-blazer).
# REQUIRED in production, e.g. a MongoDB Atlas connection string.
DB_URL=mongodb://localhost:27017/trail-blazer

# --- Sessions ---
# Long random string that signs session cookies.
# REQUIRED in production. Generate one with:  openssl rand -hex 32
SECRET=replace-with-a-long-random-string

# --- Cloudinary (image uploads) - from your Cloudinary dashboard ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret

# --- Mapbox (geocoding and maps) - from your Mapbox account ---
MAPBOX_TOKEN=your_mapbox_public_token

# --- Server ---
# PORT=3000
# NODE_ENV=production

# Set to true only when the site is served over HTTPS (enables the Secure cookie flag)
# COOKIE_SECURE=true
